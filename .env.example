# Copy to .env, fill in, and `source .env` before running anything.
#
# The configs and job scripts reference these instead of absolute paths.
# Configs read them through OmegaConf as ${oc.env:VAR}, which raises if the
# variable is unset, so a missing one fails immediately rather than silently
# resolving to an empty path.

# Task NetCDFs, gage lists, PUB/PUR split CSVs.
export DMG_DATA_ROOT=/path/to/data

# Generated embeddings and trained condensers. Stage 0 writes
# $DMG_EMBEDDING_ROOT/<dataset_name>/<dataset_name>_embeddings_<resolution>.nc
export DMG_EMBEDDING_ROOT=/path/to/embeddings

# Where runs write checkpoints, predictions and metrics. Daily-resolution
# embedding runs write tens of GB per seed.
export DMG_OUTPUT_ROOT=/path/to/output

# Pretrained foundation-model checkpoints (.pt).
export DMG_CHECKPOINT_ROOT=/path/to/checkpoints

# Only needed by the SLURM jobs in scripts/jobs/.
export DMG_REPO=/path/to/this/repo
export DMG_ENV=/path/to/virtualenv
